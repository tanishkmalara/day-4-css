body {
    margin: 0;
    font-family: Arial, sans-serif;
}

header {
    background-color: #222;
    padding: 15px 30px;
}

nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

nav h1 {
    color: white;
    margin: 0;
}

nav ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
}

nav li {
    margin-left: 25px;
}

nav a {
    color: white;
    text-decoration: none;
}

nav a:hover {
    color: #aaa;
}

main {
    text-align: center;
    padding: 50px;
}
